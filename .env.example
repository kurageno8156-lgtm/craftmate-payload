# ========================================================
# Minecraft AI Bot 設定ファイル
# ========================================================

# --- Minecraft サーバー接続設定 ---
# 接続先サーバーのアドレス (ローカルの場合は localhost または 127.0.0.1)
MC_HOST=localhost
# サーバーのポート (Java版デフォルト: 25565, LAN公開時は画面に表示された5桁の数字)
MC_PORT=25565
# Botのプレイヤー名
MC_USERNAME=AIMAN
# バージョン (自動検出する場合は空欄、指定する場合は例: 1.20.4, 1.19.4 等)
MC_VERSION=
# 認証モード (オフライン/LANサーバーは offline, 公式アカウントログインは microsoft)
MC_AUTH=offline

# --- AI 頭脳 (LLM) 設定 ---
# プロバイダの選択: gemini | groq | openai | ollama
LLM_PROVIDER=gemini

# Google Gemini API 設定 (プロバイダが gemini の場合)
# https://aistudio.google.com/ で無料取得可能
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# OpenAI API 設定 (プロバイダが openai の場合)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Groq API 設定 (プロバイダが groq の場合)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Ollama 設定 (プロバイダが ollama の場合)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# --- Web ダッシュボード設定 ---
WEB_PORT=3000

# --- エージェント動作設定 ---
# 最大連続アクション実行ステップ数 (無限ループ防止、上限100)
MAX_AGENT_STEPS=100
# 自動で食事を行うか (true / false)
AUTO_EAT=true
# 自動で装備を着用するか (true / false)
AUTO_ARMOR=true
