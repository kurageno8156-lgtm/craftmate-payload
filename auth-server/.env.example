# ============================================================
# BlockWhiz Auth Server 環境変数サンプル
# ============================================================
# 【必須】= 未設定だと起動失敗または機能しない
# 【任意】= 未設定時はデフォルト値または機能無効
# 実際の Secret・APIキー・秘密鍵は絶対にこのファイルに書かないこと。
# 本番では環境変数・シークレット管理サービスで注入する。
# ============================================================

# ---------- サーバー（必須） ----------
NODE_ENV=production                    # 【必須】本番は必ず production
PORT=8080                              # 【任意】待受ポート（既定 8080）
BIND_HOST=127.0.0.1                    # 【必須:本番】待受アドレス。
                                      # VPS+Caddy同一ホスト → 127.0.0.1
                                      # コンテナPaaS → 0.0.0.0（プラットフォームのプロキシ要件に従う）
TRUSTED_PROXY=loopback                 # 【必須:本番】信頼するプロキシ。
                                      # VPS+Caddy同一ホスト → loopback
                                      # PaaS → プラットフォーム指定のプロキシIP/CIDR
                                      # Render → render（X-Forwarded-For先頭を採用。
                                      #   Render専用。他環境ではXFF偽装の危険があるため使用禁止）
AUTH_PUBLIC_URL=https://auth.example.com  # 【必須】公開HTTPS URL（https必須）
# AUTH_DEV_INSECURE_HTTP=1             # 【開発のみ】http許可。loopback限定。本番では絶対に設定しない

# ---------- PostgreSQL（必須:本番） ----------
DATABASE_URL=                          # 【必須:本番】postgres://user:pass@host:5432/dbname
DATABASE_SSL=require                   # 【任意】require(本番推奨) | prefer | disable
# 未設定時は PGlite（開発/テスト専用）。本番では DATABASE_URL 必須。

# ---------- Redis（任意・推奨） ----------
REDIS_URL=                             # 【任意】redis:// または rediss://
                                      # 未設定 → メモリ内レート制限（単一インスタンスのみ）
                                      # 設定済みで接続失敗 → ログイン等が503（フェイルクローズ）

# ---------- JWT RS256 鍵（必須:本番） ----------
# 生成: openssl genrsa -out jwt-private.pem 2048 && openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
# PEM全文を環境変数に設定（改行は \n または実際の改行で）
AUTH_JWT_PRIVATE_KEY_PEM=              # 【必須:本番】秘密鍵。絶対にコミットしない
AUTH_JWT_PUBLIC_KEY_PEM=               # 【必須:本番】公開鍵
AUTH_JWT_KID=key-1                     # 【任意】鍵ID（既定 key-1）。ローテーション時に変更
AUTH_JWT_PREVIOUS_PUBLIC_KEY_PEM=      # 【任意】ローテーション中の旧公開鍵（検証のみ）
AUTH_JWT_ISSUER=craftmate-auth         # 【任意】JWT iss
AUTH_JWT_AUDIENCE=craftmate-desktop    # 【任意】JWT aud

# ---------- トークン有効期限（秒・任意） ----------
ACCESS_TOKEN_TTL_SECONDS=600           # アクセストークン（既定10分）
REFRESH_TOKEN_TTL_SECONDS=2592000      # リフレッシュトークン（既定30日）
OAUTH_FLOW_TTL_SECONDS=600             # OAuthフロー（既定10分）
ONE_TIME_CODE_TTL_SECONDS=60           # ワンタイムコード（既定60秒）
EMAIL_TOKEN_TTL_SECONDS=3600           # メール確認トークン（既定1時間）
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800  # パスワードリセットトークン（既定30分）

# ---------- Google OAuth（必須: Googleログインを使う場合） ----------
GOOGLE_CLIENT_ID=                      # 【必須】Google Cloud Console の OAuth クライアントID
GOOGLE_CLIENT_SECRET=                  # 【必須】同シークレット。redirect URI に
                                      # ${AUTH_PUBLIC_URL}/auth/oauth/callback/google を登録
# テスト用エンドポイント上書き（通常は未設定。本番では設定しない）
# GOOGLE_AUTH_URL=
# GOOGLE_TOKEN_URL=
# GOOGLE_JWKS_URL=
# GOOGLE_ISSUER=
# GOOGLE_USERINFO_URL=

# ---------- メール送信 ----------
MAIL_PROVIDER=mock                     # 【必須:本番=resend / 開発=mock】
                                      # 本番で mock または未設定は起動拒否。
                                      # 未対応のプロバイダ名も起動拒否。
# Resend（MAIL_PROVIDER=resend 時に必須）
RESEND_API_KEY=                        # 【必須:resend時】Resend APIキー。
                                      # Render等のシークレット管理にのみ設定。Git・ソースに書かない
MAIL_FROM=                             # 【必須:resend時】送信元（例: BlockWhiz <noreply@your-domain.com>）
                                      # 送信元ドメインのDNS認証（SPF/DKIM）がResend側で必要
MAIL_REPLY_TO=                         # 【任意】返信先アドレス

# ---------- 運用（任意） ----------
ACCOUNT_PURGE_DAYS=30                  # 削除済みアカウントの物理削除までの日数（0で無効）
