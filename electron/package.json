{
  "name": "craftmate-desktop",
  "productName": "CraftMate",
  "version": "1.3.147",
  "description": "Minecraft AI autonomous agent — desktop wrapper",
  "homepage": "https://github.com/kurageno8156-lgtm/craftmate-payload",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.craftmate.app",
    "productName": "CraftMate",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "main.js",
      "preload.js",
      "installer.html",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "../craftmate-payload",
        "to": "payload"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "synopsis": "Minecraft AI autonomous agent",
      "description": "CraftMate runs a local AI agent that autonomously plays Minecraft Java Edition, with a web dashboard for chat control.",
      "maintainer": "CraftMate",
      "icon": "icon.png",
      "desktop": {
        "entry": {
          "Name": "CraftMate",
          "Comment": "Minecraft AI autonomous agent",
          "Categories": "Utility;Game;"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  }
}
